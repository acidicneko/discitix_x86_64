# sbase (suckless core utilities), built out-of-tree in build/ from src/.
#
# sbase's own Makefile builds a helper make with $(CC) and runs it on the
# host, which can't work with a cross compiler, so the objects and tools
# are built here directly.

include ../port.mk

SRC   := src
BUILD := build

CFLAGS := -O2 -Wall $(TARGET_CFLAGS) -I$(SRC) \
	-DPREFIX=\"/usr\" -D_DEFAULT_SOURCE -D_NETBSD_SOURCE -D_BSD_SOURCE \
	-D_XOPEN_SOURCE=700 -D_FILE_OFFSET_BITS=64

LIBUTF_OBJS  := $(patsubst $(SRC)/%.c,$(BUILD)/%.o,$(wildcard $(SRC)/libutf/*.c))
LIBUTIL_OBJS := $(patsubst $(SRC)/%.c,$(BUILD)/%.o,$(wildcard $(SRC)/libutil/*.c))
LIBS := $(BUILD)/libutil.a $(BUILD)/libutf.a

# Not built:
#   cat echo ls mkdir rm test   Discitix has its own (userland/source/apps)
#   cron logger                 need syslog
#   tftp                        needs sockets
#   nice renice                 no process priorities
#   getconf                     needs a header generated by probing the target
#   bc                          generated from bc.y, needs a host yacc
SKIP := cat echo ls mkdir rm test cron logger tftp nice renice getconf bc

TOOLS ?= $(filter-out $(SKIP),$(basename $(notdir $(wildcard $(SRC)/*.c))))
BINS  := $(addprefix $(BUILD)/bin/,$(TOOLS)) $(BUILD)/bin/make

# sbase's POSIX make lives in its own directory
MAKE_OBJS := $(patsubst $(SRC)/%.c,$(BUILD)/%.o,$(wildcard $(SRC)/make/*.c))

# Sources that need Discitix changes: patches/<file>.patch is applied to a
# copy in build/patched/, leaving the submodule untouched.
PATCHES := $(wildcard patches/*.patch patches/*/*.patch)
PATCHED := $(patsubst patches/%.c.patch,%,$(PATCHES))

all: $(BINS)

$(BUILD)/bin/make: $(MAKE_OBJS) $(LIBS) $(CRT0) $(LIBC)
	@mkdir -p $(dir $@)
	$(CC) $(TARGET_LDFLAGS) -T $(LDSCRIPT) -o $@ $(CRT0) $(MAKE_OBJS) $(LIBS) -lc

$(BUILD)/bin/%: $(BUILD)/%.o $(LIBS) $(CRT0) $(LIBC)
	@mkdir -p $(dir $@)
	$(CC) $(TARGET_LDFLAGS) -T $(LDSCRIPT) -o $@ $(CRT0) $< $(LIBS) -lc

$(BUILD)/%.o: $(SRC)/%.c $(wildcard $(SRC)/*.h $(SRC)/make/*.h)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/patched/%.c: $(SRC)/%.c patches/%.c.patch
	@mkdir -p $(dir $@)
	patch -s -o $@ $< patches/$*.c.patch

$(addprefix $(BUILD)/,$(addsuffix .o,$(PATCHED))): $(BUILD)/%.o: $(BUILD)/patched/%.c $(wildcard $(SRC)/*.h $(SRC)/make/*.h)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -I$(SRC)/$(dir $*) -c $< -o $@

$(BUILD)/libutf.a: $(LIBUTF_OBJS)
	rm -f $@
	$(AR) rcs $@ $^

$(BUILD)/libutil.a: $(LIBUTIL_OBJS)
	rm -f $@
	$(AR) rcs $@ $^

install: all
	@mkdir -p $(DESTDIR)/bin
	$(INSTALL_PROGRAM) $(BINS) $(DESTDIR)/bin/

clean:
	rm -rf $(BUILD)

.PHONY: all install clean
.SECONDARY:
